# ============================================================================ #
#  ft_services — Secret template (SENSITIVE — do NOT commit real values)     #
#  Copy to secret.yaml and fill in real values (or run setup.sh to generate).#
# ============================================================================ #
apiVersion: v1
kind: Secret
metadata:
  name: ft-services-secret
type: Opaque
stringData:
  # MariaDB
  DB_PASSWORD: "__DB_PASSWORD__"

  # WordPress admin
  WP_ADMIN_PASSWORD: "__WP_ADMIN_PASSWORD__"
  # WordPress regular user
  WP_USER_PASSWORD: "__WP_USER_PASSWORD__"

  # FTP
  FTP_PASSWORD: "__FTP_PASSWORD__"

  # SSH
  SSH_PASSWORD: "__SSH_PASSWORD__"

  # phpMyAdmin blowfish secret
  PMA_SECRET: "__PMA_SECRET__"
