# ============================================================================ #
#  my_42_cursus — Root .gitignore (Enterprise C & 42 School Standards)         #
# ============================================================================ #

# Object files, dependency files & intermediate build directories
*.o
*.d
*.lo
*.obj
obj/
objs/
build/

# Static & shared libraries
*.a
*.so
*.dylib

# Build stamps (ft_printf mandatory/bonus switching)
.mandatory
.bonus

# Project compiled executables
minitalk/client
minitalk/server
minitalk/client_bonus
minitalk/server_bonus
piscine42/bsq/bsq
piscine42/rush02/ex00/rush-02
piscine42/c10/ex00/ft_display_file
piscine42/c10/ex01/ft_cat
piscine42/c10/ex02/ft_tail
piscine42/c10/ex03/ft_hexdump
piscine42/c11/ex05/do-op
a.out

# Test binaries & generated test artifacts
libft/tests/bin_test_*
ft_printf/tests/test_ft_printf
ft_printf/tests/test_asan
ft_printf/tests/cases.h
ft_printf/printfTester/*_test
ft_printf/printfTester/*_test.dSYM/

# Debugging, profiling & sanitizers
*.dSYM/
*.gcov
*.gcda
*.gcno
core
vgcore.*

# Python / Script caches
__pycache__/
*.py[cod]

# Editors, IDEs & OS metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.sudo_as_admin_successful

# ---------------------------------------------------------------------------- #
#  born2beroot — generated artefacts                                            #
# ---------------------------------------------------------------------------- #
# The emulator builds its base image from the running Debian userland on first
# use (tests/vm.sh: prepare_base).  It is host-specific and regenerated
# automatically, so it is never committed.
born2beroot/tests/.vm-base/
# Virtual disks, signature files and provisioning logs
born2beroot/*.vdi
born2beroot/*.qcow2
born2beroot/signature.txt

# ---------------------------------------------------------------------------- #
#  pipex — build artefacts and tester by-products                               #
# ---------------------------------------------------------------------------- #
pipex/obj/
pipex/pipex
pipex/tests/community/vfurmane/config.vars
pipex/tests/community/vfurmane/outs/
pipex/tests/community/michmos/outfiles/
pipex/tests/community/michmos/pipex
pipex/tests/community/michmos/last_err_log.txt
pipex/tests/community/michmos/infiles/infile_without_permissions
pipex/tests/community/yoo0lh/pipe/*
pipex/tests/community/yoo0lh/test_std/*
!pipex/tests/community/yoo0lh/pipe/.gitkeep
!pipex/tests/community/yoo0lh/test_std/.gitkeep
pipex/tests/community/vfurmane/wc -w

# ---------------------------------------------------------------------------- #
#  push_swap — build artefacts and tester by-products                          #
# ---------------------------------------------------------------------------- #
push_swap/obj/
push_swap/push_swap
push_swap/checker
push_swap/.audit.out
push_swap/tests/community/louisabricot/push_swap_result.log
push_swap/tests/community/louisabricot/push_swap_benchmark.log
push_swap/tests/community/louisabricot/push_swap_run_args.log
push_swap/tests/community/leofu/stdout
push_swap/tests/community/leofu/stderr
push_swap/tests/community/leofu/trace_basic/*/test_case_*.log
