# ============================================================================ #
#  MariaDB configuration — Inception                                         #
#  Database-only service, reachable on the Docker bridge network.           #
# ============================================================================ #
[client]
port            = 3306

[mysqld]
# Listen on all interfaces so the WordPress container can connect over the
# Docker bridge network.
bind-address            = 0.0.0.0
skip-name-resolve

# Storage / InnoDB tuning
default-storage-engine  = InnoDB
innodb-buffer-pool-size = 128M
innodb-log-file-size    = 64M

# Character set
character-set-server    = utf8mb4
collation-server        = utf8mb4_general_ci

# Logging to stdout for docker logs
log-error               = /dev/stderr
