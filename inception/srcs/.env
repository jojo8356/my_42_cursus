# ============================================================================ #
#  Inception — docker-compose environment file (42 School)                    #
#  Non-sensitive configuration. Real credentials live in Docker secrets.     #
# ============================================================================ #

# Public domain (must be resolvable, e.g. via /etc/hosts on the VM)
DOMAIN_NAME=inception.42.fr

# WordPress paths & branding
WP_PATH=/var/www/html
WP_TITLE=Inception

# WordPress admin user — MUST NOT contain "admin" or "administrator"
WP_ADMIN=inceptor
WP_ADMIN_EMAIL=inceptor@inception.42.fr
# Real WP_ADMIN_PASSWORD comes from the Docker secret (secrets/wp_admin_password.txt)

# WordPress regular user
WP_USER=contributor
WP_USER_EMAIL=contributor@inception.42.fr
# Real WP_USER_PASSWORD comes from the Docker secret (secrets/wp_user_password.txt)

# Database
DB_HOST=mariadb
DB_TABLE_PREFIX=wp_
DB_SERVER=MariaDB
DB_USER=wordpress
DB_DATABASE=wordpress
DB_PORT=3306

# Service ports
NGINX_PORT=443
WP_PORT=9000

# Bonus: FTP
FTP_USER=ftpuser
